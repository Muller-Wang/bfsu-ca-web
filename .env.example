# Production database (PostgreSQL 14+)
DATABASE_URL=postgres://user:password@localhost:5432/bfsu_makers

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Hidden by default. Set to 1 only for a dedicated demo deployment or local presentation.
DEMO_MODE=0

# Persistent local volume for uploaded templates (use a mounted volume in production).
UPLOAD_DIR=.data/uploads
